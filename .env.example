# ============================================
# AI RAG Platform - 环境变量配置
# 复制此文件为 .env 并修改相应值
# ⚠️ 生产环境务必修改所有标记 [必改] 的项
# ============================================

# ---- 数据库 ----
POSTGRES_DB=ai_rag_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456              # [必改] 生产环境使用强密码

# ---- Redis ----
REDIS_PASSWORD=                       # [建议] 生产环境设置密码
REDIS_MAXMEMORY=256mb

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=dev

# ---- AI 模型 API Keys ----
OPENAI_API_KEY=placeholder            # [必改] 替换为真实 Key
OPENAI_BASE_URL=https://api.openai.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=placeholder
ZHIPUAI_API_KEY=placeholder

# ---- 嵌入模型 ----
APP_DEFAULT_EMBEDDING_BASE_URL=http://host.docker.internal:11434
APP_DEFAULT_EMBEDDING_MODEL=bge-m3
APP_DEFAULT_EMBEDDING_DIMENSIONS=1024

# ---- 加密密钥 ----
APP_CRYPTO_KEY=SpringAiRagPlatform2024SecretKey   # [必改] 生产使用随机 32 字节字符串

# ---- JVM 参数 ----
SERVER_JAVA_OPTS=-XX:+UseZGC -XX:MaxRAMPercentage=75.0 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof
GATEWAY_JAVA_OPTS=-XX:+UseZGC -XX:MaxRAMPercentage=75.0 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof

# ---- 资源限制 ----
SERVER_MEM_LIMIT=2g
SERVER_CPU_LIMIT=2.0
GATEWAY_MEM_LIMIT=1g
GATEWAY_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
REDIS_MEM_LIMIT=512m
REDIS_CPU_LIMIT=1.0

# ---- 前端端口 ----
FRONTEND_PORT=80

# ---- 镜像配置 ----
# 镜像仓库地址（留空为本地构建，腾讯云示例: ccr.ccs.tencentyun.com/your-namespace）
REGISTRY=
# 项目名
PROJECT=ai-rag
# 镜像标签
TAG=latest

# ---- 备份 ----
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30